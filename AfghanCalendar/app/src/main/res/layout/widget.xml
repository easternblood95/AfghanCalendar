<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView android:id="@+id/weekday" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light" android:shadowColor="#99000000" android:shadowRadius="6"
        android:textColor="#FFFFFF" android:textSize="16sp" />

    <TextView android:id="@+id/day" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="sans-serif-thin" android:includeFontPadding="false"
        android:shadowColor="#99000000" android:shadowRadius="8"
        android:textColor="#FFFFFF" android:textSize="68sp" />

    <TextView android:id="@+id/month" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light" android:shadowColor="#99000000" android:shadowRadius="6"
        android:textColor="#FFFFFF" android:textSize="16sp" />

    <TextView android:id="@+id/greg" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:alpha="0.7" android:shadowColor="#99000000" android:shadowRadius="6"
        android:textColor="#FFFFFF" android:textSize="12sp" />

    <TextView android:id="@+id/holiday" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:shadowColor="#99000000" android:shadowRadius="6"
        android:textColor="#FF8A80" android:textSize="12sp" android:visibility="gone" />
</LinearLayout>
